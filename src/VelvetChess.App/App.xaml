<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VelvetChess.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Midnight">#0B1020</Color><Color x:Key="Surface">#151B2E</Color>
            <Color x:Key="Gold">#D6AE68</Color><Color x:Key="Ivory">#F3E9D6</Color><Color x:Key="Muted">#9DA7BE</Color>
            <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{StaticResource Midnight}" /></Style>
            <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Ivory}" /><Setter Property="FontFamily" Value="OpenSansRegular" /></Style>
            <Style TargetType="Button"><Setter Property="BackgroundColor" Value="{StaticResource Gold}" /><Setter Property="TextColor" Value="#101522" /><Setter Property="CornerRadius" Value="18" /><Setter Property="HeightRequest" Value="56" /><Setter Property="FontFamily" Value="OpenSansSemibold" /><Setter Property="FontSize" Value="16" /></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
